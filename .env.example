# Example only. Supply these values through Railway Variables or your local process environment.
# Never commit real provider keys or the BYOK master key.
DATABASE_URL=postgresql://user:password@localhost:5432/exploration
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Leave a Hosted key empty to keep that provider unconfigured.
HOSTED_OPENAI_API_KEY=
HOSTED_OPENAI_MODEL=gpt-4.1-mini
HOSTED_ANTHROPIC_API_KEY=
HOSTED_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Application encryption key, not a provider API key.
# Replace with a cryptographically random 32-byte key: openssl rand -hex 32
# Accepted encoding: 64 hexadecimal characters or base64 for exactly 32 bytes.
# This placeholder deliberately disables BYOK until replaced.
# Keep the same secret across deployments; changing it requires migration or key re-entry.
BYOK_MASTER_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX
